# CurseForge / BigWigs packager (https://github.com/BigWigsMods/packager).
# One zip with nineteen addon folders: UADD (the core) and its eighteen modules (Questie, Dungeon Journal, OpenMap,
# DialogueUI, ForeverXP Bar, Auctionator, Attune, LayerSwap, Auto Potion, Bagnon, Mastercraft, What's Training?, TomTom, RareScanner, Pawn, GatherMate2, Scrap, Speedy AutoLoot). This is the same list tools/make_zip.py ships. The repo is
# checked out into UADD/, so move each folder up: the zip then holds UADD/UADD.toc, UADD_Questie/UADD_Questie.toc
# and so on. Nothing is a required dependency: each module loads only when its own addon is there, and the core
# alone changes nothing. The relations are UALL Forever and ClassicUA (for names), both optional dependencies: the
# addons we translate are not listed (owner, 2026-11-20), since a player needs none of them for UADD.
package-as: UADD

move-folders:
  UADD/UADD: UADD
  UADD/UADD_Questie: UADD_Questie
  UADD/UADD_DungeonJournal: UADD_DungeonJournal
  UADD/UADD_OpenMap: UADD_OpenMap
  UADD/UADD_DialogueUI: UADD_DialogueUI
  UADD/UADD_ForeverXPBar: UADD_ForeverXPBar
  UADD/UADD_Auctionator: UADD_Auctionator
  UADD/UADD_Attune: UADD_Attune
  UADD/UADD_LayerSwap: UADD_LayerSwap
  UADD/UADD_AutoPotion: UADD_AutoPotion
  UADD/UADD_Bagnon: UADD_Bagnon
  UADD/UADD_Mastercraft: UADD_Mastercraft
  UADD/UADD_WhatsTraining: UADD_WhatsTraining
  UADD/UADD_TomTom: UADD_TomTom
  UADD/UADD_RareScanner: UADD_RareScanner
  UADD/UADD_Pawn: UADD_Pawn
  UADD/UADD_GatherMate2: UADD_GatherMate2
  UADD/UADD_Scrap: UADD_Scrap
  UADD/UADD_SpeedyAutoLoot: UADD_SpeedyAutoLoot
  UADD/UADD_WaypointUI: UADD_WaypointUI
  UADD/UADD_ForeverQuestPins: UADD_ForeverQuestPins
  UADD/UADD_LiteMount: UADD_LiteMount
  UADD/UADD_WhatTheWhisper: UADD_WhatTheWhisper
  UADD/UADD_LootTriage: UADD_LootTriage

# names come from UALL Forever or ClassicUA when one is installed; without them the menus are still Ukrainian
optional-dependencies:
  - uall-forever-ukrainian-localization
  - classicua

manual-changelog:
  filename: UADD/CHANGELOG.md
  markup-type: markdown

# dev-only files: none of these ship
ignore:
  - docs
  - tools
  - data
  - dist
  - install.bat
  - README.md
  - CLAUDE.md
  - CLAUDE.local.md
  - size-budget.json
  - .gitignore
  - .gitattributes
  - .github
  - .pytest_cache
  - LICENSE
