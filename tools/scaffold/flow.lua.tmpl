-- Lua helpers and steps for flow_@x@.py, on the @TITLE@ stand-in (tools/harness/@x@) with the real @F@.
-- Run before the game starts (it gives the harness a tooltip that keeps its lines); the steps look the module up when
-- they run. HARNESS.@x@: inject() puts made-up Ukrainian for the stand-in's made-up English into ns.@X@ by
-- "Code."..UADD.Hash(en), as the real data is keyed; R[n]() runs step n and returns a list of {name, ok, detail}.
-- No English of @TITLE@ here: the stand-in's texts are read from @T@StandIn.T.
local H = HARNESS
local M, R = {}, {}
H.@x@, M.R = M, R

-- As in the game, only a tooltip has AddLine (U.Walk leaves a frame with AddLine to U.TipLines).
local create = CreateFrame
CreateFrame = function(kind, name, ...)
    local f = create(kind, name, ...)
    if kind ~= "GameTooltip" then rawset(f, "AddLine", false) end
    return f
end

-- GameTooltip as the game has it (font strings by name), so U.TipLines works.
do
    local tip, name, n = GameTooltip, "GameTooltip", 0
    for i = 1, 8 do
        _G[name .. "TextLeft" .. i] = tip:CreateFontString(name .. "TextLeft" .. i, nil, "GameTooltipText")
        _G[name .. "TextRight" .. i] = tip:CreateFontString(name .. "TextRight" .. i, nil, "GameTooltipText")
    end
    local function Clear(self)
        for i = 1, 8 do _G[name .. "TextLeft" .. i]:SetText(nil) _G[name .. "TextRight" .. i]:SetText(nil) end
        n = 0
        local f = self:GetScript("OnTooltipCleared") if f then f(self) end
    end
    tip.SetOwner = function(self, o) self.__owner = o Clear(self) end
    tip.ClearLines = Clear
    tip.NumLines = function() return n end
    tip.AddLine = function(_, t) if n < 8 then n = n + 1 _G[name .. "TextLeft" .. n]:SetText(t) end end
end
local function Tip1() return GameTooltipTextLeft1:GetText() end

function M.wait(seconds) for _ = 1, math.ceil(seconds / 0.05 - 1e-6) do H.step(0.05) end end
function M.key(down)
    H.keys.SHIFT = down
    H.fire("MODIFIER_STATE_CHANGED", "LSHIFT", down and 1 or 0)
    M.wait(0.4)
end
function M.say(msg) local n = #H.chat @T@StandIn.Say(msg) return H.chat[n + 1] end
function M.print(line) local n = #H.chat print(line) return H.chat[n + 1] end

local UK = { title = "Хитка дошка гаджетів", tab = "Вкладка плонку", button = "Плонкнути гаджет",
    late = "Хиткий пізній гаджет", say = "Гаджет плонкнуто", tip = "Клацніть, щоб плонкнути гаджет" }
local S, U, ns, T, PRE

local function CyrFont(fs) local p = fs and fs:GetFont() return p and U.IsCyrFont(p) and true or false end
local function Res(out, name, ok, d) out[#out + 1] = { name, ok, d ~= nil and tostring(d) or "" } return out end
local function Key(en) return "Code." .. U.Hash(en) end
local function Uadd(cmd) SlashCmdList.UADD("@key@ " .. cmd) M.wait(0.3) end
local function Texts() return { S.title:GetText(), S.tab.fs:GetText(), S.button:GetText() } end
local function Is(list, want)
    for i, k in ipairs({ "title", "tab", "button" }) do if list[i] ~= want[k] then return false end end
    return true
end
local function Show(list) return table.concat(list, " | ") end

function M.inject()
    S, U, ns = @T@StandIn, UADD, H.ns.@F@
    T, PRE = S.T, S.PREFIX
    for k, uk in pairs(UK) do ns.@X@[Key(T[k])] = uk end
    ns.Words.Forget()
    ns.Screen.W.Forget()          -- the walker keeps each text's last answer (none before the made-up data)
    S.Redraw()
    M.wait(0.1)
end
function M.late() return S.Late() end

function M.real(en)               -- a real text of the addon's (read by Python at run time) put on the title
    if not S then M.inject() end
    if en == nil then S.Redraw() return false, false end
    local want = ns.@X@[Key(en)]
    if type(want) ~= "string" or (ns.SORT[Key(en)] or "") ~= "" then return false, false end
    S.title:SetText(en)
    return S.title:GetText(), want
end

R[1] = function()
    M.inject()
    local t, out = Texts(), {}
    Res(out, "the walk: title, tab and button are ours", Is(t, UK), Show(t))
    Res(out, "each in a Cyrillic font", CyrFont(S.title) and CyrFont(S.tab.fs) and CyrFont(S.button), "")
    return out
end

R[2] = function()
    M.key(true)
    local held = Texts()
    M.key(false)
    local out = {}
    Res(out, "hold key: English while held", Is(held, T), Show(held))
    Res(out, "hold key: ours again on release", Is(Texts(), UK), Show(Texts()))
    return out
end

R[3] = function()
    local out = {}
    Uadd("off")
    local off, font = Texts(), CyrFont(S.title)
    S.Redraw() M.wait(0.1)
    local again, line = Texts(), M.say(T.say)
    Uadd("on")
    Res(out, "off: English back", Is(off, T), Show(off))
    Res(out, "off: the addon's font back", not font, "")
    Res(out, "off: a redraw and a print stay English", Is(again, T) and line == PRE .. T.say, Show(again) .. " | " .. tostring(line))
    Res(out, "on: ours again", Is(Texts(), UK), Show(Texts()))
    return out
end

R[4] = function()
    local fs = S.Late()
    M.wait(0.2)
    return Res({}, "a window made later (its name prefix) is ours", fs:GetText() == UK.late, fs:GetText())
end

R[5] = function()
    local out = {}
    local mine, unknown, bare = M.say(T.say), M.say("Wibble plonk"), M.print(T.say) --@chat
    Res(out, "a print with its prefix: the prefix kept, the rest ours", mine == PRE .. UK.say, mine) --@chat
    Res(out, "its prefix with an unknown text is left alone", unknown == PRE .. "Wibble plonk", unknown) --@chat
    Res(out, "the same text without its prefix is left alone", bare == T.say, bare) --@chat
    return out
end

R[6] = function()
    local out = {}
    S.Tip() --@chat
    Res(out, "a tooltip line from its files is ours", Tip1() == UK.tip, Tip1()) --@chat
    GameTooltip:SetOwner(UIParent) GameTooltip:AddLine(T.tip) GameTooltip:Show()
    Res(out, "the same line from other code stays English", Tip1() == T.tip, Tip1())
    GameTooltip:Hide()
    return out
end

R[7] = function()
    local out, fight = {}, InCombatLockdown
    Uadd("off")
    InCombatLockdown = function() return true end
    Uadd("on")
    InCombatLockdown = fight
    H.fire("PLAYER_REGEN_ENABLED")
    M.wait(0.1)
    Res(out, "turned on in a fight: ours when the fight ends", Is(Texts(), UK), Show(Texts()))
    return out
end

R[8] = function()
    local mt = getmetatable(ns.@X@)
    setmetatable(ns.@X@, { __index = function() error("@x@: planted error") end })
    for i = 1, 6 do pcall(ns.Words.Translate, "Plonk wibble " .. i) end
    setmetatable(ns.@X@, mt)
    M.wait(0.3) S.Redraw() M.wait(0.1)
    return Res({}, "5 errors turn the module off, English back", not ns.On() and Is(Texts(), T),
        tostring(ns.On()) .. " | " .. Show(Texts()))
end
