"""Makes @F@'s Ukrainian from review files, keyed by hashes of @TITLE@'s string literals.

  python3 tools/make_@x@_text.py review [DIR]   write local/@x@/review_NN.txt (keeps every UA by key; fills an empty
                                                UA from the draft files)
  python3 tools/make_@x@_text.py build  [DIR]   write @F@/data/text01..NN.lua
  python3 tools/make_@x@_text.py stats  [DIR]   count done / left / refused per batch

@LIC@
Its English is read from the installed addon (or DIR, or $UADD_ADDONS_DIR/@T@) and goes only into local/@x@/
(git-ignored). The data keeps only hashes and our Ukrainian. Rules: tools/@x@_rules.py; source: tools/@x@_source.py
(`python3 tools/@x@_source.py all` prints every literal and why it is left out); machinery: tools/key_text.py,
tools/make_code_text.py.
"""
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
sys.path.insert(0, str(HERE))
import make_code_text as C  # noqa: E402
import @x@_rules as R  # noqa: E402
from @x@_source import addon_dir, source, version  # noqa: E402,F401

NAME = "@T@"
